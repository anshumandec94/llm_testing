{
  "base_config": {
    "data_dir": "data/ml-32m",
    "embeddings_dir": "embeddings/chroma",
    "mlflow_tracking_uri": "sqlite:///mlflow.db",
    "experiment_name": "abm-recsys",
    "eval_user_frac": 0.1,
    "validation_frac": 0.1,
    "holdout_frac": 0.2,
    "min_ratings": 50,
    "experiment_profile": "recommender_only",
    "recommender_eval_split": "validation",
    "num_rounds": 1,
    "rec_list_size": 6,
    "accept_k": 5,
    "max_requests_per_round": 3,
    "mf_features": 64,
    "mf_epochs": 10,
    "mf_regularization": 0.1,
    "mf_damping": 5.0,
    "user_pref_features": 8,
    "semantic_model": "all-MiniLM-L6-v2",
    "random_seed": 42,
    "force_rebuild_embeddings": false,
    "agent_type": "associative",
    "agent_types": [],
    "agent_type_proportions": [],
    "agent_assignment_mode": "one_to_one",
    "watch_signal": 4.5,
    "add_to_list_signal": 3.0,
    "beta_alpha_max": 8.0,
    "beta_beta_max": 8.0,
    "default_attention_strategy": "LinearDecay",
    "default_attention_decay_rate": 0.15,
    "default_attention_recovery": "full",
    "default_attention_recovery_rate": 0.5,
    "default_attendance_strategy": "LogisticAttendance",
    "sat_ewma_alpha": 0.4,
    "attend_recency_bonus": 0.3,
    "attend_recency_penalty": 0.1,
    "attend_noise_scale": 0.2,
    "archetype_mix": {"casual": 0.7, "binger": 0.2, "critic": 0.1}
  },
  "candidate_overrides": [
    {"user_pref_features": 4},
    {"user_pref_features": 6},
    {"user_pref_features": 8},
    {"user_pref_features": 12},
    {"user_pref_features": 16},
    {"user_pref_features": 24},
    {"user_pref_features": 32},
    {"user_pref_features": 48},
    {"user_pref_features": 64}
  ],
  "selection_metric": "error/int_mse",
  "minimize_selection_metric": true,
  "validation_split": "validation",
  "final_eval_split": "held_out"
}
